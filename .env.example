# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=tarcin_palani_jwt_secret_key_2026_secure_embedded_hub
JWT_EXPIRES_IN=7d

# File Upload Settings (in Megabytes)
MAX_FILE_SIZE_MB=50

# ==========================================
# Central Supabase / PostgreSQL Credentials
# ==========================================
# Paste your Supabase project credentials here:
# 1. Sign up / log in to https://supabase.com
# 2. Create a new project (e.g. "tarcin-interns")
# 3. Go to Project Settings -> API
# 4. Copy Project URL and Service Role Key (secret):

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional Direct PostgreSQL Connection String (from Supabase Database settings)
# DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
